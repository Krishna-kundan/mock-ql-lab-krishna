# Salesforce DX
.sfdx/
.sf/
.localdevserver/
deploy-options.json

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# Environment
.env
.env.*
!.env.example

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Bootstrap state
.bootstrap-state

# Per-machine local Claude settings (never tracked).
.claude/settings.local.json

# Per-machine debounce stamps older plugins wrote into the repo (current ones keep
# them under ~/.quantum-leap-launchpad/). Kept for teammates still on those plugins.
.claude/.skills-freshness-check
.claude/.skills-drift-check
.claude/.resync-drift-check

# Per-machine setup state: Scopezilla source location + pending setup steps
# (decisions/0071). The engagement profile beside it (engagement.json) IS tracked.
.launchpad/local.json
# Build briefs are generated per build and never committed; the PR carries their
# stamp line instead (decisions/0082 W6).
.launchpad/briefs/
# /ql-capture-intent's batch working notes, derived from raw transcripts (dirty source).
.launchpad/capture/

# Pi agent local state (per machine), written by Pi and sf-pi sessions (#474). Pi's
# project config (.pi/settings.json, .pi/mcp.json, .pi/extensions|skills|prompts|themes/)
# is shareable and stays tracked, so this lists the state files, not .pi/.
.pi/sf-skills-usage.json
.pi/state/
.pi/todos/
.pi/plans/
.pi/code-analyzer/logs/
.pi/sf-llm-gateway.json

# Note: the vendored ql-* skills in .agents/skills and .claude/skills ARE
# tracked, so every harness has them on clone (decisions/0087). The Salesforce
# build skills are installed per machine by launchpad/scripts/setup.mjs and never
# land here (decisions/0085). When .launchpad/repo.json sets commit_skills: false,
# /ql-init-engagement appends an ignore block for the ql-* skills below
# (decisions/0072).

# Salesforce DX project extras (sf project generate)
**/lwc/jsconfig.json
coverage/
logs
*.log
.pmdCache
.eslintcache
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
**/__pycache__/
**/.venv/
**/venv/
